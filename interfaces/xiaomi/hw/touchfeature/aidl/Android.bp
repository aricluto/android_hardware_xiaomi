// Only the Java client: the service and its NDK library are prebuilts
aidl_interface {
    name: "vendor.xiaomi.hw.touchfeature",
    srcs: ["vendor/xiaomi/hw/touchfeature/*.aidl"],
    stability: "vintf",
    owner: "xiaomi",
    backend: {
        cpp: {
            enabled: false,
        },
        ndk: {
            enabled: false,
        },
        java: {
            platform_apis: true,
        },
    },
    versions_with_info: [
        {
            version: "1",
            imports: [],
        },
    ],
    frozen: true,
}
